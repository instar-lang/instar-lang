letrec ack (m: Int): Code[Int -> Int] =
  fun@2 (n: Code[Int]) =>
    if m == 0 then n +@2 lift{2}(1)
    else
      if@2 n == 0 then ack(m-1)(lift{2}(1))
      else ack(m-1)(ack(m)(n -@2 lift{2}(1)))
in
let ack2 = fun@2 (n: Code[Int]) => ack(2)(n) in
ack2

/*
Need to generate three functions:
ack_2(n) = if n=0 then ack_1(1) else ack_1(ack_2(n-1))
ack_1(n) = if n=0 then ack_0(1) else ack_0(ack_1(n-1))
ack_0(n) = n+1
*/
